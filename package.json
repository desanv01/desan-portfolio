{
  "name": "desan-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "format": "prettier --write package.json package-lock.json tsconfig.json next.config.ts eslint.config.mjs .prettierrc.json src tests scripts",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json next.config.ts eslint.config.mjs .prettierrc.json src tests scripts",
    "lint": "eslint src tests scripts next.config.ts --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/health.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "test:preview": "node --test tests/preview.test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
