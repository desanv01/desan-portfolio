{
  "name": "desan-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start --hostname 127.0.0.1",
    "format": "prettier --write package.json package-lock.json tsconfig.json next.config.ts eslint.config.mjs .prettierrc.json src tests scripts",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json next.config.ts eslint.config.mjs .prettierrc.json src tests scripts",
    "lint": "eslint src tests scripts next.config.ts --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/health.test.mjs tests/design*.mjs tests/public-data.test.mjs tests/public-data-proxy.test.mjs tests/public-rendering.test.mjs tests/preview-safety.test.mjs tests/owner-design-*.test.mjs tests/owner-backend-*.test.mjs tests/content-import.test.mjs tests/discovery.test.mjs tests/integration-github-cache.test.mjs",
    "test:smoke": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --test tests/smoke.test.mjs",
    "test:preview": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --test tests/preview.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx scripts/backend-cli.ts migrate",
    "db:migrate:status": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx scripts/backend-cli.ts status",
    "db:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx scripts/backend-cli.ts seed",
    "owner:bootstrap": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx scripts/backend-cli.ts bootstrap --bootstrap",
    "test:backend": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx --test --test-force-exit --test-concurrency=1 tests/backend.test.ts",
    "test:backend-routing": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --test tests/backend-routing.test.mjs",
    "fixture:public": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx scripts/phase4-fixtures.ts --publish-synthetic --bootstrap-fixture-owner",
    "test:public": "node scripts/verify-public-preview.mjs",
    "test:public-preview": "node scripts/verify-public-preview.mjs --packaged",
    "test:owner": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx --test --test-force-exit --test-concurrency=1 tests/owner-backend.test.ts",
    "owner:jobs": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx scripts/owner-jobs.ts run --watch",
    "content:import": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx scripts/content-import.ts",
    "github:refresh": "node --import tsx scripts/github-cache.ts refresh",
    "test:content-import": "node --env-file-if-exists=.env.local --env-file-if-exists=tmp/phase3-runtime.env --import tsx --test --test-force-exit --test-concurrency=1 tests/content-import-backend.test.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "fontkit": "2.0.4",
    "graphql": "16.11.0",
    "next": "16.4.3",
    "payload": "3.92.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "happy-dom": "21.0.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "dompurify": "3.4.17"
  }
}
