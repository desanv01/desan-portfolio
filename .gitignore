# Public repository allowlist. Research/design packs and local coordination stay local.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/next.config.*
!/next-env.d.ts
!/eslint.config.*
!/.prettierrc*
!/.prettierignore
!/.nvmrc
!/.npmrc
!/.env.example
!/playwright.config.*
!/compose.yaml
!/.dockerignore
!/src/
!/tests/
!/scripts/
!/public/
!/docs/
/docs/*
!/docs/engineering/

# Generated files and secrets remain excluded even inside allowed directories.
node_modules/
.next/
out/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
*.log
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
Thumbs.db
