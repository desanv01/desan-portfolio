# Copy to .env.local and supply private values for the intended environment.
# Never use NEXT_PUBLIC_ for database, CMS, or storage credentials.
# compose.yaml reads POSTGRES_PASSWORD with --env-file .env.local.
POSTGRES_PASSWORD=
POSTGRES_PORT=55433
# postgresql://desan:<POSTGRES_PASSWORD>@127.0.0.1:55433/desan_dev
DATABASE_URI=
# Separate disposable database; never point integration tests at real content.
TEST_DATABASE_URI=
# Generate a random value of at least 32 characters; never use a sample in production.
PAYLOAD_SECRET=
CMS_SERVER_URL=http://127.0.0.1:3000
# Canonical public address; keep unset during local evaluation.
PUBLIC_SITE_URL=
# Indexing remains off unless explicitly enabled with a public HTTPS address.
PUBLIC_SITE_INDEXABLE=0
# Local metadata cache; refreshed explicitly by github:refresh.
GITHUB_METADATA_CACHE_DIRECTORY=tmp/github-metadata
MEDIA_DIRECTORY=tmp/phase3-media
# Local evaluation only: enables private recovery mail capture, not real delivery.
LOCAL_RECOVERY_SPOOL=0
RECOVERY_SPOOL_DIRECTORY=tmp/phase3-recovery
# Supply privately only when explicitly running the local bootstrap command.
OWNER_EMAIL=
OWNER_PASSWORD=
# Cloud deployment: server-only values, never NEXT_PUBLIC_. Keep local mode
# for evaluation unless the private Supabase buckets have been configured.
MEDIA_STORAGE=local
GITHUB_METADATA_CACHE_STORAGE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=desan-media
SUPABASE_CACHE_BUCKET=desan-cache
# Remote/cloud database connections always verify TLS. Supply the provider CA
# as a PEM value or a private file path when it is not in the system trust store.
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
# Default pool is 3 connections in cloud mode, 10 for local evaluation.
DATABASE_POOL_MAX=
SCHEDULE_MODE=local
# Managed jobs require a random server-only secret of at least 32 characters.
JOBS_SECRET=
# Hosted recovery uses the explicitly rehearsed operator procedure.
OWNER_RECOVERY_MODE=operator
